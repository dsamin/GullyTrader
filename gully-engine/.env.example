# Kalshi API — use the same RSA key from KalshiTrader if you want to share the account
KALSHI_API_ENV=demo                 # demo | prod
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=            # absolute path to PEM file

# LLM provider (OpenRouter by default — same naming as KalshiTrader)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# Per-agent overrides (fall back to OPENROUTER_MODEL if unset)
SCANNER_LLM_PROVIDER=openrouter
SCANNER_LLM_MODEL=qwen/qwen-2.5-72b-instruct
RESEARCH_LLM_PROVIDER=openrouter
RESEARCH_LLM_MODEL=deepseek/deepseek-chat-v3-0324
DECISION_LLM_PROVIDER=openrouter
DECISION_LLM_MODEL=qwen/qwen-2.5-72b-instruct
EXIT_LLM_PROVIDER=openrouter
EXIT_LLM_MODEL=qwen/qwen-2.5-72b-instruct

# Cricket data feed
CRICKET_FEED_PROVIDER=stub          # stub | cricapi | sportmonks
CRICKET_FEED_API_KEY=

# Engine knobs
GULLYTRADER_DB_PATH=./gullytrader.db
GULLYTRADER_ENABLE_ORCHESTRATOR=0   # 1 = run entry/exit threads
GULLYTRADER_EXIT_MODE=shadow        # shadow | live
GULLYTRADER_SYNC_INTERVAL_SECONDS=60
GULLYTRADER_LIVE_POLL_INTERVAL_SECONDS=5
GULLYTRADER_AGENT_LOGS_MAX_AGE_DAYS=7
